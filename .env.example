# Sentinel environment configuration example.
# Copy to `.env` and adjust values for your environment.
#
# WARNING: The defaults below are for LOCAL DEVELOPMENT ONLY.
# Never deploy to shared, staging, or production environments with
# default credentials. Always set strong, unique secrets there.

# --- Postgres ---
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel
POSTGRES_DB=sentinel
POSTGRES_PORT=5432

# --- Backend ---
BACKEND_PORT=8000

# --- Grafana ---
GRAFANA_PORT=3000
# Admin password for Grafana. The compose file falls back to `admin` when
# unset, which is insecure. Set a strong, non-default value in any deployed
# environment (shared, staging, production).
GRAFANA_ADMIN_PASSWORD=admin
